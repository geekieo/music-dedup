{
  "name": "musicdedup",
  "version": "2.0.0",
  "description": "本地重复音乐管理工具 — 纯JS声纹识别 + 智能保留策略",
  "keywords": [
    "music",
    "duplicate",
    "dedupe",
    "audio",
    "fingerprint",
    "flac",
    "mp3",
    "m4a",
    "chromaprint",
    "acoustid",
    "musicbrainz",
    "electron"
  ],
  "license": "MIT",
  "homepage": "https://github.com/geekieo/music-dedup",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geekieo/music-dedup.git"
  },
  "bugs": {
    "url": "https://github.com/geekieo/music-dedup/issues"
  },
  "author": {
    "name": "Geekieo",
    "url": "https://github.com/geekieo"
  },
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "node scripts/run-electron.mjs",
    "release": "node scripts/release.js",
    "electron": "node scripts/run-electron.mjs",
    "smoke": "node scripts/run-electron.mjs --smoke",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "scan:abort": "node scripts/scan-abort-test.mjs",
    "scan:phase": "node scripts/scan-phase-merge-test.mjs",
    "scan:trash": "node scripts/trash-flow-test.mjs",
    "scan:smartkeep": "node scripts/smartkeep-flow-test.mjs",
    "scan:smartkeep-scan": "node scripts/smartkeep-scan-test.mjs",
    "test:setup": "node scripts/setup-test-env.mjs",
    "icons": "node scripts/render-icons.mjs",
    "build:win": "node scripts/build-win.mjs",
    "build:mac": "node scripts/build-mac.mjs",
    "build:linux": "electron-builder --linux AppImage deb --publish never"
  },
  "dependencies": {
    "audio-decode": "^3.10.1",
    "electron-updater": "^6.8.9",
    "fast-glob": "^3.3.2",
    "music-metadata": "^10.5.0",
    "node-id3": "^0.2.9",
    "node-sqlite3-wasm": "0.8.60",
    "opencc-js": "^1.3.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.geekieo.musicdedup",
    "productName": "MusicDedup",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "lib/**",
      "public/**",
      "assets/**"
    ],
    "asarUnpack": [
      "lib/**",
      "node_modules/**",
      "electron/scan-worker.js",
      "electron/fp-decode-pool.mjs",
      "electron/fp-decode-cli.mjs",
      "electron/match-pool.mjs",
      "electron/match-worker.js",
      "electron/updater-download-cli.mjs"
    ],
    "npmRebuild": false,
    "afterPack": "scripts/after-pack.cjs",
    "electronLanguages": [
      "zh-CN",
      "zh-TW",
      "en-US"
    ],
    "compression": "maximum",
    "publish": [
      {
        "provider": "github",
        "owner": "geekieo",
        "repo": "music-dedup"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "MusicDedup.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MusicDedup",
      "artifactName": "MusicDedup-Setup-${version}.exe",
      "differentialPackage": false
    },
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "MusicDedup-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "assets/icons",
      "category": "Audio",
      "maintainer": "geekieo <geekieo@users.noreply.github.com>",
      "synopsis": "本地重复音乐管理工具",
      "description": "纯 JS 声纹识别 + 智能保留策略的本地重复音乐管理工具。",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
