{
  "name": "musicdedup",
  "version": "2.0.0",
  "description": "本地重复音乐管理工具 — 纯JS声纹识别 + 智能保留策略",
  "keywords": [
    "music",
    "duplicate",
    "dedupe",
    "audio",
    "fingerprint",
    "flac",
    "mp3",
    "m4a",
    "chromaprint",
    "acoustid",
    "musicbrainz",
    "electron"
  ],
  "license": "MIT",
  "homepage": "https://github.com/geekieo/music-dedup",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geekieo/music-dedup.git"
  },
  "bugs": {
    "url": "https://github.com/geekieo/music-dedup/issues"
  },
  "author": {
    "name": "Geekieo",
    "url": "https://github.com/geekieo"
  },
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "node scripts/run-electron.mjs",
    "release": "node scripts/release.js",
    "electron": "node scripts/run-electron.mjs",
    "smoke": "node scripts/run-electron.mjs --smoke",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "scan:abort": "node scripts/scan-abort-test.mjs",
    "scan:phase": "node scripts/scan-phase-merge-test.mjs",
    "scan:trash": "node scripts/trash-flow-test.mjs",
    "scan:smartkeep": "node scripts/smartkeep-flow-test.mjs",
    "scan:smartkeep-scan": "node scripts/smartkeep-scan-test.mjs",
    "migrate-data": "node scripts/migrate-data.mjs",
    "test:setup": "node scripts/setup-test-env.mjs",
    "icons": "node scripts/render-icons.mjs",
    "build:win": "node scripts/build-win.mjs"
  },
  "dependencies": {
    "audio-decode": "^3.10.1",
    "fast-glob": "^3.3.2",
    "music-metadata": "^10.5.0",
    "node-id3": "^0.2.9",
    "node-sqlite3-wasm": "0.8.57",
    "opencc-js": "^1.3.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.geekieo.musicdedup",
    "productName": "MusicDedup",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "scripts/migrate-data.mjs",
      "lib/**",
      "public/**",
      "assets/**"
    ],
    "asarUnpack": [
      "lib/**",
      "node_modules/**",
      "electron/scan-worker.js",
      "electron/fp-decode-pool.mjs",
      "electron/fp-decode-cli.mjs"
    ],
    "extraResources": [
      {
        "from": "fpcalc.exe",
        "to": "fpcalc.exe"
      }
    ],
    "npmRebuild": false,
    "afterPack": "scripts/after-pack.cjs",
    "electronLanguages": ["zh-CN", "zh-TW", "en-US"],
    "compression": "maximum",
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MusicDedup",
      "artifactName": "MusicDedup Setup ${version}.exe",
      "differentialPackage": false
    },
    "linux": {
      "icon": "assets/icons",
      "target": [
        "AppImage"
      ]
    }
  }
}
